NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=
# demo simulates voice operations; live never falls back to demo.
VOICE_MODE=demo
VOICE_API_TOKEN=
VOICE_ACTIVATE_URL=
VOICE_CALL_URL=
VOICE_HISTORY_URL=
VOICE_SETTINGS_URL=
# Explicitly approved test destinations, E.164, comma separated. Required in live mode.
VOICE_TEST_ALLOWLIST=
# Server-only gate. Leave unset/false until n8n independently verifies Bonzo ownership, phone, and DNC.
CRM_LEAD_CALLS_VERIFIED=false
